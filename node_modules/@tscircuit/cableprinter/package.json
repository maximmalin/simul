{
  "name": "@tscircuit/cableprinter",
  "version": "0.0.4",
  "description": "Cable definition DSL and schemas for tscircuit assemblies",
  "module": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/cableprinter.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "start": "cosmos",
    "build:site": "cosmos-export",
    "test:update": "BUN_UPDATE_SNAPSHOTS=1 bun test",
    "build": "tsup lib/index.ts --format esm --dts --clean",
    "prepack": "bun run build",
    "test:package": "bun run build && node tests/package-smoke.mjs"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@jscad/modeling": "2.12.7",
    "@resvg/resvg-js": "^2.6.2",
    "@tscircuit/alphabet": "^0.0.24",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gl-matrix": "^3.4.4",
    "jscad-electronics": "^0.0.187",
    "looks-same": "^10.0.1",
    "poppygl": "0.0.30",
    "react": "^19.1.1",
    "react-cosmos": "^7.0.0",
    "react-cosmos-plugin-vite": "^7.0.0",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "tsup": "^8.5.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  }
}
