* Structural ngspice analysis: Ch B patch 2.45 GHz
* 2-port: port 1 = feed, port 2 = radiated wave, pin 3 = GND
* Wires ANT_CHB per touchstone ant_chb.s2p

V1        feed 0 dc 0 ac 1 portnum 1 z0 50
Xant_chB  feed space 0 ANT_CHB touchstone="sim/outputs/ngspice/ant_chb.s2p"
Rfeed     feed 0 50

V2        space 0 dc 0 ac 0 portnum 2 z0 50

.include sim/outputs/ngspice/ant_sparams.lib

.control
sp lin 101 800e6 4.2e9
print S_1_1 S_2_1
.endc
.end