* Structural ngspice analysis: Ch C patch 5.8 GHz
* 2-port: port 1 = feed, port 2 = radiated wave, pin 3 = GND
* Wires ANT_CHC per touchstone ant_chc.s2p

V1        feedc 0 dc 0 ac 1 portnum 1 z0 50
Xant_chc  feedc space 0 ANT_CHC touchstone="sim/outputs/ngspice/ant_chc.s2p"
Rfeedc    feedc 0 50

V2        spacec 0 dc 0 ac 0 portnum 2 z0 50

.include sim/outputs/ngspice/ant_sparams.lib

.control
sp lin 101 4.5e9 7.0e9
print S_1_1 S_2_1
.endc
.end