# Generated files
build/
*.log
*.tmp
*.swp
.DS_Store
node_modules/
package-lock.json

# KiCad generated files
*.kicad_*
*.glb
*.step
*.pdf
*.jpg
*.png

# Python cache
__pycache__/
*.pyc

# OS files
Thumbs.db

# Placeholder project file from the legacy text-template generator
crystal_radio.kicadproject

# FreeCAD generated project/backup files (rebuild from the *_fc.py builders)
*.FCStd
*.FCStd1
*.FCBak

# FMU build artifacts
sim/fmu/
*.fmu

# SPICE raw files / scratch
*.raw
sim/work/
sim/sim/
*.erc

# tscircuit working directory (build cache; published artifacts go to out/)
.tscircuit/
hardware/tscircuit/out/

# bundled three.js viewer (rebuilt by `make viewer` from viewer/main.js)
hardware/tscircuit/viewer/dist/

# GNU Radio co-sim raw I/Q dump and NEC scratch output
out/virtual_rx_iq.c64
out/df_array.out

# локальное состояние агентного моста (проекты создаются из UI)
.krystal/

# frontend: node_modules и сборка
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# SKiDL / openEMS scratch output
sdr_skidl_circuit*.net
sdr_skidl_circuit_sklib.py
sim/outputs/*.json
sim/outputs/*.png
sim/work/

# SKiDL's SPICE backend emits an 8-byte stub here; the real deck is
# sim/netlists/sdr_skidl_ngspice.cir (export_ngspice.py).
sim/netlists/sdr_skidl_ngspice.net

# run logs
sim/logs/

# FreeCAD: временные файлы восстановления
hardware/enclosure/*.FCBak
hardware/enclosure/*.FCStd1

# Сторонний shallow-клон https://github.com/KiCad/kicad-footprints.
# В сборке не используется (нет fp-lib-table, платы генерирует tscircuit),
# ранее попал в индекс как gitlink и в клоне давал пустой каталог.
/local_footprints/

# Служебное: pid-файлы, логи и база чекпоинтов графа
.run/
backend/.run/

# Результат ngspice из экспорта. Файл на 76 МБ, генерируется заново
# при каждом запуске export_ngspice.py / build_fmu.py. В git попал
# по ошибке и раздувал репозиторий.
/sim/netlists/sdr_trace.dat
/sdr_trace.dat
