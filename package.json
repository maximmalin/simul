  },
  "overrides": {
    "circuit-json": "^0.0.528"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^4.64.0",
    "rollup-plugin-dts": "^6.5.1",
    "three": "^0.179.1"
  }
