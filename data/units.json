{
  "version": 1,
  "описание": "Единицы измерения и их канонический вид. Одна и та же величина может быть записана по-разному («А» и «A», «Вт» и «W», «В» и «V»), поэтому сравнивать их надо по канону.",

  "canonical": {
    "v": "V", "volt": "V", "volt.": "V", "в": "V", "вольт": "V", "вольты": "V",
    "a": "A", "amp": "A", "ampere": "A", "а": "A", "ампер": "A", "ампера": "A",
    "w": "W", "watt": "W", "вт": "W", "ватт": "W", "ватты": "W",
    "hz": "Hz", "гц": "Hz", "кгц": "kHz", "mhz": "MHz", "мгц": "MHz", "ггц": "GHz",
    "f": "F", "ф": "F", "фарад": "F", "фарады": "F",
    "nf": "nF", "нф": "nF", "pf": "pF", "пф": "pF", "uf": "uF", "мкф": "uF", "µf": "uF",
    "mf": "mF", "мф": "mF",
    "h": "H", "гн": "H", "uh": "uH", "мкгн": "uH", "µh": "uH", "mh": "mH", "мгн": "mH",
    "nh": "nH", "нн": "nH",
    "ohm": "Ohm", "ом": "Ohm", "Ω": "Ohm", "ω": "Ohm",
    "%": "%", "процент": "%", "процентов": "%",
    "k": "k", "m": "m", "u": "u", "n": "n", "p": "p", "g": "g",
    "deg": "deg", "градус": "deg", "°": "deg"
  },

  "scale": {
    "k": 1e3, "к": 1e3, "m": 1e-3, "м": 1e-3, "u": 1e-6, "µ": 1e-6,
    "μ": 1e-6, "мк": 1e-6, "n": 1e-9, "н": 1e-9, "p": 1e-12, "п": 1e-12,
    "g": 1e9, "г": 1e9, "meg": 1e6
  }
}
